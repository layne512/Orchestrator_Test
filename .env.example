# .env.example — template. Copy to .env and fill in real values.
# .env is gitignored. NEVER commit real tokens.

# GitHub PAT for cloning peptide-website from the orchestrator sandbox.
# Generate at: https://github.com/settings/personal-access-tokens/new
# Scope: fine-grained, Layne512/peptide-website only, Contents: read+write,
#        Metadata: read. Expiration: 30 days.
GITHUB_TOKEN=github_pat_REPLACE_ME

# Default peptide-website checkout location (where this session clones to)
PEPTIDE_REPO=/home/user/peptide-website

# Default anchor SHA used by scripts/validate-spec.sh
ANCHOR_SHA=486f63b
